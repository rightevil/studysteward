# AI Provider — pick one: claude, openai, deepseek, kimi, glm, custom
STUDYSTEWARD_AI_PROVIDER=agnes
STUDYSTEWARD_AI_API_KEY=sk-xxx
STUDYSTEWARD_AI_MODEL=agnes-2.0-flash
# For custom provider, also set:
# STUDYSTEWARD_AI_BASE_URL=https://your-api.com/v1/chat/completions
MINERU_API_TOKEN=sk-xxx
# Knowledge base
STUDYSTEWARD_DATA_DIR=./.studysteward
STUDYSTEWARD_CHUNK_SIZE=512
STUDYSTEWARD_CHUNK_OVERLAP=20

# HuggingFace mirror (for users in China)
HF_ENDPOINT=https://hf-mirror.com
